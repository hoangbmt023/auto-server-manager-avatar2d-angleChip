# ==============================================================================
# Avatar Multi-Bot Manager - Environment Variables Specification
# Copy this file to '.env.development' (local) or '.env.production' (cPanel hosting)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime
# ------------------------------------------------------------------------------
# Runtime environment: 'development' | 'production'
NODE_ENV=development

# Web Dashboard HTTP Port
PORT=3001

# Application Partition Identifier
DEFAULT_APP_ID=avatar_main

# Record Management System (RMS) persistence mode: 'file' | 'memory'
DEFAULT_RMS_MODE=file

# JVM Heap Memory Limit per MicroEmulator Bot Process (in Megabytes)
DEFAULT_MAX_MEMORY=256

# ------------------------------------------------------------------------------
# 2. MySQL Database Persistence (Clean Architecture / Drizzle ORM)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=avatar_2d_bot_manager

# Maximum active pooled database connections
DB_CONNECTION_LIMIT=10

# ------------------------------------------------------------------------------
# 3. Security & Cryptography
# ------------------------------------------------------------------------------
# Master secret key used for AES-256 account password encryption and bcrypt hashing
# IMPORTANT: Use a cryptographically secure random string in production!
APP_SECRET=your_super_secret_encryption_key_min_32_chars_2026

# JSON Web Token (JWT) secret and expiration policies
JWT_SECRET=your_jwt_signing_secret_key_2026
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Maximum allowable HTTP JSON request body size in Megabytes (Protects against DoS / memory exhaustion)
MAX_PAYLOAD_SIZE_MB=5

# ------------------------------------------------------------------------------
# 4. Cross-Origin Resource Sharing (CORS) Whitelist
# ------------------------------------------------------------------------------
# Comma-separated list of allowed web dashboard origins in production (e.g., https://bot.yourdomain.com,https://api.yourdomain.com)
# In development, leave empty to allow all origins ('*')
CORS_ALLOWED_ORIGINS=
