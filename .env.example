# Example Environment Configuration (Copy to .env.development or .env.production)
NODE_ENV=development
PORT=3001

# Secret key used to encrypt passwords in config.json (AES-256)
APP_SECRET=your_secret_encryption_key_here

DEFAULT_APP_ID=avatar_main
DEFAULT_RMS_MODE=file
DEFAULT_MAX_MEMORY=256

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=avatar_bot_manager
DB_CONNECTION_LIMIT=10
